diff --git a/sqlalchemy_cubrid/dialect.py b/sqlalchemy_cubrid/dialect.py
index 0651140..28e606d 100644
--- a/sqlalchemy_cubrid/dialect.py
+++ b/sqlalchemy_cubrid/dialect.py
@@ -251,6 +251,201 @@ _RE_UNIQUE_KEY = re.compile(
 )
 _RE_BRACKET_IDENT = re.compile(r"\[([^\]]+)\]")
 
+# A SHOW COLUMNS default that is already valid SQL as printed (a number); any
+# other default is read from SHOW CREATE TABLE (#865).
+_RE_NUMERIC_DEFAULT = re.compile(r"^[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?$")
+
+
+def _default_is_shown_as_sql(column: Any) -> bool:
+    """Whether a reflected ``SHOW COLUMNS`` default is valid SQL as printed.
+
+    Only a number on a numeric column is; a string column's ``'5'`` is also
+    printed as ``5`` and must be read from ``SHOW CREATE TABLE`` (#865).
+    """
+    default = column["default"]
+    if default is None:
+        return True
+    return isinstance(column["type"], (sqltypes.Numeric, sqltypes.Integer, MONETARY)) and bool(
+        _RE_NUMERIC_DEFAULT.match(str(default).strip())
+    )
+
+
+_RE_DEFAULT_KEYWORD = re.compile(r"\bDEFAULT\b", re.IGNORECASE)
+
+
+def _skip_quoted(text: str, i: int) -> int:
+    """Return the index after the ``'...'`` literal starting at *text[i]*."""
+    i += 1
+    while i < len(text):
+        if text[i] == "'":
+            if i + 1 < len(text) and text[i + 1] == "'":
+                i += 2
+                continue
+            return i + 1
+        i += 1
+    raise ValueError("unterminated string literal")
+
+
+def _skip_enum_labels(text: str, i: int) -> int:
+    """Return the index after the ``ENUM(...)`` label list opening at *text[i]*.
+
+    ``SHOW CREATE TABLE`` prints ENUM labels without doubling their quotes
+    (``ENUM('it's', 'a, b', 'c (d)')``), so a label ends only at a quote
+    followed by ``, '`` or ``)``. A label that itself contains ``', '`` stays
+    ambiguous, as in ``SHOW COLUMNS`` (#631).
+    """
+    i += 1
+    while i < len(text):
+        while i < len(text) and text[i] == " ":
+            i += 1
+        if i < len(text) and text[i] == ")":
+            return i + 1
+        if i >= len(text) or text[i] != "'":
+            raise ValueError("unexpected ENUM label list")
+        j = i + 1
+        while True:
+            j = text.find("'", j)
+            if j < 0:
+                raise ValueError("unterminated ENUM label")
+            rest = text[j + 1 :]
+            if rest.startswith(")"):
+                return j + 2
+            if re.match(r",\s*'", rest):
+                i = j + 1 + rest.index("'")
+                break
+            j += 1
+    raise ValueError("unterminated ENUM label list")
+
+
+def _is_enum_open(text: str, i: int) -> bool:
+    """Whether the ``(`` at *text[i]* opens an ``ENUM(...)`` label list."""
+    head = text[max(0, i - 5) : i]
+    return head.upper().endswith("ENUM") and (len(head) < 5 or not head[0].isalnum())
+
+
+def _split_ddl_items(ddl: str) -> list[str]:
+    """Split the parenthesized CREATE TABLE body on top-level commas.
+
+    Quotes, ``[identifiers]`` and nested parentheses are skipped, and the
+    body ends at the parenthesis that closes it, so table options such as a
+    ``COMMENT='...)'`` after it are not read.
+    """
+    items: list[str] = []
+    i = 0
+    # The body opens at the first parenthesis outside a [bracketed] name,
+    # which may itself contain one (``CREATE TABLE [sct ref, (x)] (``).
+    while i < len(ddl) and ddl[i] != "(":
+        i = ddl.index("]", i) + 1 if ddl[i] == "[" else i + 1
+    if i >= len(ddl):
+        raise ValueError("no CREATE TABLE body")
+    i += 1
+    start = i
+    depth = 0
+    while i < len(ddl):
+        ch = ddl[i]
+        if ch == "'":
+            i = _skip_quoted(ddl, i)
+            continue
+        if ch == "[":
+            i = ddl.index("]", i) + 1
+            continue
+        if ch == "(" and _is_enum_open(ddl, i):
+            i = _skip_enum_labels(ddl, i)
+            continue
+        if ch == "(":
+            depth += 1
+        elif ch == ")":
+            if depth == 0:
+                items.append(ddl[start:i])
+                return items
+            depth -= 1
+        elif ch == "," and depth == 0:
+            items.append(ddl[start:i])
+            start = i + 1
+        i += 1
+    raise ValueError("unbalanced CREATE TABLE body")
+
+
+def _default_term(text: str, i: int) -> str:
+    """Return the default expression that starts at *text[i]*.
+
+    One term, as ``SHOW CREATE TABLE`` prints it: a string literal with an
+    optional prefix (``N'..'``, ``X'..'``, ``_utf8'..'``, ``date '..'``), a
+    number, or a keyword or function call (``SYS_DATETIME``,
+    ``TO_CHAR(SYS_DATETIME, 'YYYY')``).
+    """
+    start = i
+    match = re.compile(r"[-+]?[\w.]*").match(text, i)
+    i = match.end() if match else i
+    j = i
+    while j < len(text) and text[j] == " ":
+        j += 1
+    if j < len(text) and text[j] == "'" and (i == start or text[start:i].isidentifier()):
+        return text[start : _skip_quoted(text, j)]
+    if i < len(text) and text[i] == "(":
+        depth = 0
+        while i < len(text):
+            if text[i] == "'":
+                i = _skip_quoted(text, i)
+                continue
+            if text[i] == "(":
+                depth += 1
+            elif text[i] == ")":
+                depth -= 1
+                if depth == 0:
+                    return text[start : i + 1]
+            i += 1
+        raise ValueError("unbalanced parentheses")
+    if i == start:
+        raise ValueError("no default expression")
+    return text[start:i]
+
+
+def _column_defaults_from_ddl(ddl: str) -> dict[str, str]:
+    """Map column names to their ``DEFAULT`` SQL in ``SHOW CREATE TABLE`` DDL (#865).
+
+    ``SHOW COLUMNS`` prints a string default without its quotes (``it''s``,
+    an empty string, or ``NULL`` for the string ``'NULL'``), a date as
+    ``01/02/2020`` and both ``'CURRENT_USER'`` and ``USER`` as
+    ``CURRENT_USER``; the DDL prints each as valid, unambiguous SQL.
+    """
+    defaults: dict[str, str] = {}
+    for item in _split_ddl_items(ddl):
+        item = item.strip()
+        if not item.startswith("["):
+            continue
+        end = item.index("]")
+        name = item[1:end]
+        rest = item[end + 1 :]
+        i = 0
+        while i < len(rest):
+            ch = rest[i]
+            if ch == "'":
+                i = _skip_quoted(rest, i)
+                continue
+            if ch == "(" and _is_enum_open(rest, i):
+                i = _skip_enum_labels(rest, i)
+                continue
+            if ch == "(":
+                depth = 1
+                i += 1
+                while depth and i < len(rest):
+                    if rest[i] == "'":
+                        i = _skip_quoted(rest, i)
+                        continue
+                    depth += {"(": 1, ")": -1}.get(rest[i], 0)
+                    i += 1
+                continue
+            match = _RE_DEFAULT_KEYWORD.match(rest, i)
+            if match and (i == 0 or not (rest[i - 1].isalnum() or rest[i - 1] == "_")):
+                j = match.end()
+                while j < len(rest) and rest[j] == " ":
+                    j += 1
+                defaults[name] = _default_term(rest, j)
+                break
+            i += 1
+    return defaults
+
 
